{
  "name": "gmp-mcp",
  "version": "0.1.0",
  "description": "Write-capable Model Context Protocol server for Google Marketing Platform.",
  "author": "REllwood",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/REllwood/GMP-MCP.git"
  },
  "type": "module",
  "bin": {
    "gmp-mcp": "./dist/index.js"
  },
  "files": [
    "dist/*.d.ts",
    "dist/*.js",
    "dist/*.js.map",
    "!dist/*.test.*",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "tsx src/index.ts",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.4.7",
    "google-auth-library": "^10.6.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.6"
  }
}
